---
const { images } = Astro.props;
---
<div
  id="gallery-modal-backdrop"
  class="hidden fixed inset-0 z-50 items-center justify-center bg-neutral-900/90 backdrop-blur-sm p-4"
>
  <button
    type="button"
    id="gallery-modal-close"
    aria-label="Cerrar"
    class="absolute top-6 right-6 z-10 h-11 w-11 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-white/20 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width={18} height={18} viewBox="0 0 24 24" class="fill-white">
      <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
    </svg>
  </button>

  <button
    type="button"
    id="gallery-modal-prev"
    aria-label="Anterior"
    class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-10 h-[52px] w-[52px] rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-white/20 transition-colors"
  >
    <svg width={20} height={20} viewBox="0 0 24 24" class="fill-white">
      <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
    </svg>
  </button>

  <button
    type="button"
    id="gallery-modal-next"
    aria-label="Siguiente"
    class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-10 h-[52px] w-[52px] rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-white/20 transition-colors"
  >
    <svg width={20} height={20} viewBox="0 0 24 24" class="fill-white">
      <path d="m10 6-1.41 1.41L14.17 12l-5.58 4.59L10 18l7-6z" />
    </svg>
  </button>

  <img
    id="gallery-modal-image"
    alt={images[0].alt}
    class="max-w-full max-h-[80vh] w-auto h-auto object-contain rounded-2xl shadow-2xl"
    src={images[0].url}
  />

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 px-5 py-2 rounded-full bg-white/10 backdrop-blur-md">
    <span id="gallery-modal-counter" class="text-sm font-semibold text-white tracking-wide">
      1 / {images.length}
    </span>
  </div>
</div>
