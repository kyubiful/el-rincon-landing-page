---
import Map from './Map.astro'
---
<div class='pt-32 -mt-16 lg:pt-32 lg:-mt-16 pb-32 bg-gray-50' id='contact'>
  <div class='max-w-6xl mx-auto px-6'>
  <div class='grid grid-cols-1 md:grid-cols-2 rounded-3xl overflow-hidden shadow-xl'>
    <div class='bg-green-600 p-8 md:p-10 flex flex-col justify-center gap-6'>
      <div class='w-full'>
        <p class='text-sm font-semibold uppercase tracking-widest text-green-100 mb-2'>Contacto</p>
        <h3 class='font-display italic font-medium text-3xl text-white mb-4'>Te esperamos</h3>
        <div class='flex flex-col gap-3'>
          <p class='flex items-start gap-2 text-green-50'>
            <svg xmlns="http://www.w3.org/2000/svg" width={20} height={20} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={2} stroke-linecap="round" stroke-linejoin="round" class='text-white shrink-0 mt-0.5'>
              <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <span>Pl. de la Libertad, 5, 13411 Valdemanco del Esteras, Ciudad Real</span>
          </p>
          <p class='flex items-center gap-2 text-green-50'>
            <svg xmlns="http://www.w3.org/2000/svg" width={20} height={20} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={2} stroke-linecap="round" stroke-linejoin="round" class='text-white shrink-0'>
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <a class='text-white hover:underline' href='mailto:elrincon.valdemanco@gmail.com'>elrincon.valdemanco@gmail.com</a>
          </p>
          <p class='flex items-center gap-2 text-green-50'>
            <svg xmlns="http://www.w3.org/2000/svg" width={20} height={20} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={2} stroke-linecap="round" stroke-linejoin="round" class='text-white shrink-0'>
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a class='text-white hover:underline' href='tel:+34680968872'>680 96 88 72</a>
          </p>
        </div>
      </div>
      <div class='w-full rounded-xl overflow-hidden'>
        <Map />
      </div>
    </div>
    <div class='bg-white p-8 md:p-10 flex flex-col gap-4 justify-center'>
      <h2 class='font-display italic font-medium text-3xl text-center text-gray-800'>Contacta con nosotros</h2>
      <form id='contact-form' class='space-y-4'>
        <div>
          <label for='contact-name' class='text-black font-semibold block mb-1'>*Nombre</label>
          <input
            id='contact-name'
            name='name'
            type='text'
            placeholder='Ingrese su nombre'
            class='w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600 border-gray-300'
          />
          <p class='error-message hidden text-red-600 text-xs mt-1'>Error, no puede enviar el campo vacío</p>
        </div>
        <div>
          <label for='contact-email' class='text-black font-semibold block mb-1'>*Email</label>
          <input
            id='contact-email'
            name='email'
            type='email'
            placeholder='Ingrese su email'
            class='w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600 border-gray-300'
          />
          <p class='error-message hidden text-red-600 text-xs mt-1'>Error, no puede enviar el campo vacío</p>
        </div>
        <div>
          <label for='contact-phone' class='text-black font-semibold block mb-1'>*Teléfono</label>
          <input
            id='contact-phone'
            name='phone'
            type='text'
            placeholder='Ingrese su teléfono'
            class='w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600 border-gray-300'
          />
          <p class='error-message hidden text-red-600 text-xs mt-1'>Error, no puede enviar el campo vacío</p>
        </div>
        <div>
          <label for='contact-message' class='text-black font-semibold block mb-1'>*Mensaje</label>
          <textarea
            id='contact-message'
            name='message'
            rows='4'
            placeholder='Escriba un mensaje'
            class='w-full border rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600 border-gray-300'
          ></textarea>
          <p class='error-message hidden text-red-600 text-xs mt-1'>Error, no puede enviar el campo vacío</p>
        </div>
        <p class='text-xs text-gray-500 italic'>*Campos obligatorios</p>
        <button
          id='contact-submit'
          type='submit'
          disabled
          class='inline-flex items-center rounded-lg px-6 py-3 bg-green-600 text-white font-medium hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed'
        >
          Enviar
        </button>
      </form>
    </div>
  </div>
  </div>
</div>

<script>
  import { showToast } from '../scripts/toast'

  const form = document.getElementById('contact-form')
  const submitBtn = document.getElementById('contact-submit')

  const FIELDS = ['name', 'email', 'phone', 'message']

  const getInput = (field) => form?.querySelector(`[name="${field}"]`)
  const getErrorEl = (field) => getInput(field)?.closest('div')?.querySelector('.error-message')

  const setFieldError = (field, hasError) => {
    const input = getInput(field)
    const errorEl = getErrorEl(field)
    if (hasError) {
      errorEl?.classList.remove('hidden')
      input?.classList.remove('border-gray-300')
      input?.classList.add('border-red-500')
    } else {
      errorEl?.classList.add('hidden')
      input?.classList.remove('border-red-500')
      input?.classList.add('border-gray-300')
    }
  }

  const updateSubmitState = () => {
    const allFilled = FIELDS.every((field) => (getInput(field)?.value.trim() ?? '') !== '')
    if (submitBtn) submitBtn.disabled = !allFilled
  }

  FIELDS.forEach((field) => {
    getInput(field)?.addEventListener('input', () => {
      updateSubmitState()
      const input = getInput(field)
      if (input && input.value.trim() !== '') setFieldError(field, false)
    })
  })

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const values = {}
    let hasError = false

    FIELDS.forEach((field) => {
      const value = getInput(field)?.value.trim() ?? ''
      values[field] = value
      if (value === '') hasError = true
      setFieldError(field, value === '')
    })

    if (hasError) return

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(values),
      })

      if (!response.ok) {
        throw new Error('Error al enviar')
      }

      form.reset()
      updateSubmitState()
      showToast('Mensaje enviado correctamente', 'success')
    } catch (err) {
      showToast('Error al envíar el mensaje', 'error')
    }
  })
</script>
