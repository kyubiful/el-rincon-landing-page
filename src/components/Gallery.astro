---
import CardImage from './Cards/CardImage.astro'
import GalleryModal from './Modals/GalleryModal.astro'
import { GALLERY } from '../data/gallery'
---
<div class='bg-green-200 -skew-y-3 z-0 relative -mt-14 py-32'>
  <div class='max-w-4xl sm:w-3/4 flex justify-center m-auto py-24 skew-y-3' id='gallery'>
    <div class='flex flex-col justify-center items-center gap-10 w-full'>
      <div class='flex flex-col items-center gap-2 mx-12'>
        <p class='text-sm font-semibold uppercase tracking-widest text-green-600'>La aldea</p>
        <h2 class='font-display italic font-medium text-5xl md:text-6xl text-center text-gray-700'>Galería de Fotos</h2>
      </div>
      <div
        id='gallery-collapse'
        class='w-full overflow-hidden transition-[max-height] duration-500 ease-in-out max-h-[600px]'
      >
        <div class='w-full sm:w-auto grid grid-cols-1 gap-4 lg:gap-4 sm:grid-cols-2 lg:grid-cols-3 p-10'>
          <div class='space-y-4'>
            {
              GALLERY.map((image) => image.id < 3 && <CardImage url={image.url} id={image.id} alt={image.alt} />)
            }
            <div class='sm:hidden flex justify-center'>
              <button
                type='button'
                class='gallery-image-btn inline-flex items-center rounded-lg px-4 py-2 bg-green-100 text-green-800 hover:bg-green-200 transition-colors'
                data-image-id='4'
              >
                Ver más imágenes
              </button>
            </div>
          </div>
          <div class='space-y-4 hidden sm:block'>
            {
              GALLERY.map((image) => image.id >= 3 && image.id <= 5 && <CardImage url={image.url} id={image.id} alt={image.alt} />)
            }
          </div>
          <div class='space-y-4 hidden lg:block'>
            {
              GALLERY.map((image) => image.id > 5 && <CardImage url={image.url} id={image.id} alt={image.alt} />)
            }
          </div>
        </div>
      </div>
      <div class='bg-gradient-to-b from-transparent to-green-200 -mt-24 h-24 w-full z-10 flex items-center justify-center'>
        <button
          type='button'
          id='gallery-expand-btn'
          class='inline-flex items-center gap-2 rounded-lg px-6 py-3 bg-green-600 text-white font-medium hover:bg-green-700 transition-colors -mt-5 shadow-xl'
        >
          Ver más fotos
          <svg width='16' height='16' viewBox='0 0 24 24' class='fill-white'><path d='M12 16.5 4.5 9l1.4-1.4L12 13.7l6.1-6.1L19.5 9z'></path></svg>
        </button>
      </div>
    </div>
  </div>
</div>
<GalleryModal images={GALLERY} />

<script>
  import { GALLERY } from '../data/gallery'

  const images = GALLERY
  const lastImageId = images[images.length - 1].id
  let currentIndex = 0

  const collapse = document.getElementById('gallery-collapse')
  const expandBtn = document.getElementById('gallery-expand-btn')
  const modalBackdrop = document.getElementById('gallery-modal-backdrop')
  const modalImage = document.getElementById('gallery-modal-image')
  const modalClose = document.getElementById('gallery-modal-close')
  const modalPrev = document.getElementById('gallery-modal-prev')
  const modalNext = document.getElementById('gallery-modal-next')
  const modalCounter = document.getElementById('gallery-modal-counter')

  const setImage = (id) => {
    currentIndex = id
    const image = images[id]
    if (image && modalImage) {
      modalImage.src = image.url
      modalImage.alt = image.alt
    }
    if (modalCounter) modalCounter.textContent = `${id + 1} / ${images.length}`
  }

  const openModal = (id) => {
    setImage(id)
    modalBackdrop?.classList.remove('hidden')
    modalBackdrop?.classList.add('flex')
  }

  const closeModal = () => {
    modalBackdrop?.classList.add('hidden')
    modalBackdrop?.classList.remove('flex')
  }

  document.querySelectorAll('.gallery-image-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.getAttribute('data-image-id'))
      openModal(id)
    })
  })

  expandBtn?.addEventListener('click', () => {
    collapse?.classList.remove('max-h-[600px]')
    collapse?.classList.add('max-h-[3000px]')
    expandBtn.classList.add('hidden')
  })

  modalClose?.addEventListener('click', closeModal)

  modalBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalBackdrop) closeModal()
  })

  modalPrev?.addEventListener('click', () => {
    let prevId = currentIndex - 1
    if (prevId < 0) prevId = lastImageId
    setImage(prevId)
  })

  modalNext?.addEventListener('click', () => {
    let nextId = currentIndex + 1
    if (nextId > lastImageId) nextId = 0
    setImage(nextId)
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal()
  })
</script>
