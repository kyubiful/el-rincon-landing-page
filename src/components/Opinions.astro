---
import Opinion from './Opinion.astro'
import { OPINIONS } from '../data/opinions'

const PAGE_SIZE = 3
const pages = []
for (let i = 0; i < OPINIONS.length; i += PAGE_SIZE) {
  pages.push(OPINIONS.slice(i, i + PAGE_SIZE))
}
---

<div class="pt-24 lg:pt-28 bg-green-50" id="opinion">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-24">
    <div class="flex flex-col items-center gap-2 text-center mb-14">
      <p class="text-sm font-semibold uppercase tracking-widest text-green-600">Opiniones</p>
      <h2 class="font-display italic font-medium text-4xl md:text-5xl text-gray-800">Lo que dicen nuestros huéspedes</h2>
    </div>

    <div class="flex items-center gap-5">
      <button
        id="opinions-prev"
        type="button"
        aria-label="Opiniones anteriores"
        class="w-12 h-12 rounded-full bg-green-50 border border-green-200 flex items-center justify-center flex-shrink-0 hover:bg-green-100 transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" class="fill-green-600"
          ><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg
        >
      </button>

      <div id="opinions-pages" class="flex-grow overflow-hidden">
        {
          pages.map((page, i) => (
            <div class="opinion-page grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7" data-page={i} hidden={i !== 0}>
              {page.map((opinion) => (
                <Opinion name={opinion.name} stars={opinion.stars} text={opinion.text} />
              ))}
            </div>
          ))
        }
      </div>

      <button
        id="opinions-next"
        type="button"
        aria-label="Siguientes opiniones"
        class="w-12 h-12 rounded-full bg-green-50 border border-green-200 flex items-center justify-center flex-shrink-0 hover:bg-green-100 transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" class="fill-green-600"
          ><path d="m10 6-1.41 1.41L14.17 12l-5.58 4.59L10 18l7-6z"></path></svg
        >
      </button>
    </div>

    <div id="opinions-dots" class="flex justify-center gap-2 mt-9">
      {
        pages.map((_, i) => (
          <button
            type="button"
            class="opinion-dot h-2 rounded-full transition-all"
            data-dot={i}
            aria-label={`Ir a la página ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</div>

<script>
  const pagesEls = Array.from(document.querySelectorAll<HTMLElement>('.opinion-page'))
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.opinion-dot'))
  const prevBtn = document.getElementById('opinions-prev')
  const nextBtn = document.getElementById('opinions-next')
  let current = 0

  const render = () => {
    pagesEls.forEach((el, i) => {
      el.hidden = i !== current
    })
    dots.forEach((dot, i) => {
      dot.className =
        'opinion-dot h-2 rounded-full transition-all ' + (i === current ? 'w-6 bg-green-600' : 'w-2 bg-green-200')
    })
  }

  prevBtn?.addEventListener('click', () => {
    current = current === 0 ? pagesEls.length - 1 : current - 1
    render()
  })

  nextBtn?.addEventListener('click', () => {
    current = current === pagesEls.length - 1 ? 0 : current + 1
    render()
  })

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      current = i
      render()
    })
  })

  render()
</script>
