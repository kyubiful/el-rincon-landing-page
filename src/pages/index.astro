---
import Layout from '../layouts/Layout.astro'
import Menu from '../components/Menu.astro'
import Home from '../components/Home.astro'
import Gallery from '../components/Gallery.astro'
import HouseInfo from '../components/HouseInfo.astro'
import Contact from '../components/Contact.astro'
import Opinions from '../components/Opinions.astro'
import Footer from '../components/Footer.astro'
import MobileMenu from '../components/MobileMenu.astro'

import '../styles.css'
---

<Layout
	title="Casa Rural El Rincón"
	description="Casa Rural El Rincón en Valdemanco del Esteras (Ciudad Real): alquiler íntegro para 1-10 personas, 3 habitaciones, terraza y vistas a la montaña. 5★ en 10 opiniones de huéspedes."
>
	<main>
		<Menu />
		<MobileMenu />
		<Home />
		<Gallery />
		<HouseInfo />
		<Opinions />
		<Contact />
		<Footer />
	</main>
</Layout>
<script>

	setTimeout(() => {
		const homeCard = document.querySelector('#homeCard')
		const homeImages = document.querySelectorAll('.homeImage')
		const info = document.querySelector('#homeInfo')

		function handleIntersection(entries, observer){
			entries.forEach((entry) => {
				if(entry.isIntersecting) {
					entry.target.classList.add('animate-fadeIn')
					entry.target.classList.toggle('opacity-1')
					entry.target.classList.toggle('opacity-0')
					observer.unobserve(entry.target)
				}
			})
		}

		const observer = new IntersectionObserver(handleIntersection)

		homeImages.forEach(image => observer.observe(image))

		observer.observe(homeCard)
		observer.observe(info)
	}, 400)

</script>